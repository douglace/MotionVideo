 "sentences": [
  {
   "i": 0,
   "t": 0,
   "text": "Des archéologues dégagent une ville ensevelie."
  },
  {
   "i": 1,
   "t": 2.2,
   "text": "Dans la cendre, ils découvrent du pain."
  },
  {
   "i": 2,
   "t": 4.36,
   "text": "Pas une sculpture."
  },
  {
   "i": 3,
   "t": 5.67,
   "text": "Du vrai pain romain, carbonisé."
  },
  {
   "i": 4,
   "t": 8.05,
   "text": "Retour en l’an soixante-dix-neuf."
  },
  {
   "i": 5,
   "t": 10.25,
   "text": "Au pied du Vésuve, Pompéi est une ville commerçante."
  },
  {
   "i": 6,
   "t": 13.08,
   "text": "On y achète des repas déjà préparés."
  },
  {
   "i": 7,
   "t": 14.99,
   "text": "On écrit sur les murs, on travaille, on fait des affaires."
  },
  {
   "i": 8,
   "t": 18.35,
   "text": "Puis le volcan entre en éruption."
  },
  {
   "i": 9,
   "t": 20.55,
   "text": "Des pierres, la cendre s’accumulent sur les bâtiments."
  },
  {
   "i": 10,
   "t": 23.74,
   "text": "Une partie des habitants fuit."
  },
  {
   "i": 11,
   "t": 25.25,
   "text": "D’autres restent prisonniers de la catastrophe."
  },
  {
   "i": 12,
   "t": 28.42,
   "text": "La ville disparaît sous les dépôts volcaniques."
  },
  {
   "i": 13,
   "t": 30.39,
   "text": "Des siècles passent."
  },
  {
   "i": 14,
   "t": 31.82,
   "text": "En mille sept cent quarante-huit, les fouilles commencent sous le règne de Charles de Bourbon."
  },
  {
   "i": 15,
   "t": 36.53,
   "text": "Les ouvriers dégagent des rues, des boutiques, des murs peints."
  },
  {
   "i": 16,
   "t": 40.53,
   "text": "Mais à certains endroits, ils trouvent des cavités étranges dans la cendre durcie."
  },
  {
   "i": 17,
   "t": 44.53,
   "text": "En mille huit cent soixante-trois, Giuseppe Fiorelli utilise du plâtre pour remplir ces empreintes."
  },
  {
   "i": 18,
   "t": 49.63,
   "text": "Et les formes de personnes disparues réapparaissent."
  },
  {
   "i": 19,
   "t": 52.35,
   "text": "Ce ne sont pas des statues antiques : ce sont des moulages."
  },
  {
   "i": 20,
   "t": 55.44,
   "text": "Pompéi révèle alors bien plus que la puissance de Rome."
  },
  {
   "i": 21,
   "t": 58.71,
   "text": "Elle préserve les traces de vies ordinaires, jusque dans les objets du quotidien."
  },
  {
   "i": 22,
   "t": 63.18,
   "text": "Imagine notre propre ville retrouvée dans deux mille ans."
  },
  {
   "i": 23,
   "t": 65.92,
   "text": "Quel objet raconterait le mieux notre époque ?"
  }
 ]
}