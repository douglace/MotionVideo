 "sentences": [
  {
   "i": 0,
   "t": 0,
   "text": "Ce papier va bouleverser une frontière."
  },
  {
   "i": 1,
   "t": 2.0,
   "text": "Berlin, neuf novembre mille neuf cent quatre-vingt-neuf."
  },
  {
   "i": 2,
   "t": 5.35,
   "text": "Depuis vingt-huit ans, un mur sépare la ville."
  },
  {
   "i": 3,
   "t": 8.21,
   "text": "Mais à l’automne, le régime est-allemand vacille."
  },
  {
   "i": 4,
   "t": 10.89,
   "text": "Des milliers de citoyens manifestent pour la liberté, d’autres quittent le pays."
  },
  {
   "i": 5,
   "t": 15.3,
   "text": "Le pouvoir prépare de nouvelles règles de voyage."
  },
  {
   "i": 6,
   "t": 17.81,
   "text": "Elles doivent être annoncées le lendemain."
  },
  {
   "i": 7,
   "t": 19.68,
   "text": "À dix-huit heures cinquante, devant les journalistes, Günter Schabowski lit les nouvelles dispositions."
  },
  {
   "i": 8,
   "t": 24.94,
   "text": "Un journaliste lui demande quand elles entrent en vigueur."
  },
  {
   "i": 9,
   "t": 27.43,
   "text": "Sa réponse, traduite de l’allemand : immédiatement, sans délai."
  },
  {
   "i": 10,
   "t": 30.89,
   "text": "Les médias relaient la nouvelle."
  },
  {
   "i": 11,
   "t": 32.48,
   "text": "Devant leur télévision, les Berlinois de l’Est comprennent que la frontière est ouverte."
  },
  {
   "i": 12,
   "t": 36.53,
   "text": "Ils se rendent aux points de passage."
  },
  {
   "i": 13,
   "t": 38.47,
   "text": "Pourtant, sur place, les gardes n’ont pas reçu d’ordre d’ouverture générale."
  },
  {
   "i": 14,
   "t": 42.45,
   "text": "L’attente se prolonge, la foule grossit."
  },
  {
   "i": 15,
   "t": 44.96,
   "text": "À Bornholmer Strasse, vers vingt-trois heures trente, le passage est finalement ouvert."
  },
  {
   "i": 16,
   "t": 49.34,
   "text": "Les habitants traversent, se retrouvent, s’embrassent."
  },
  {
   "i": 17,
   "t": 52.19,
   "text": "D’autres points de passage suivent."
  },
  {
   "i": 18,
   "t": 54.07,
   "text": "Le mur n’est pas démoli cette nuit-là, mais il cesse d’enfermer."
  },
  {
   "i": 19,
   "t": 57.43,
   "text": "Onze mois plus tard, l’Allemagne est réunifiée."
  },
  {
   "i": 20,
   "t": 60.27,
   "text": "La conférence de presse a précipité l’événement, mais des mois de mobilisation l’avaient rendu possible."
  },
  {
   "i": 21,
   "t": 65.0,
   "text": "À ton avis, qui a fait tomber le mur : les dirigeants, ou les citoyens ?"
  }
 ]
}