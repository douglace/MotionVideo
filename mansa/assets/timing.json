 "sentences": [
  {
   "i": 0,
   "t": 0,
   "text": "Un roi traverse le désert avec une fortune en or."
  },
  {
   "i": 1,
   "t": 2.81,
   "text": "À son passage, le prix du métal précieux va même chuter."
  },
  {
   "i": 2,
   "t": 6.24,
   "text": "Nous sommes en mille trois cent vingt-quatre."
  },
  {
   "i": 3,
   "t": 8.48,
   "text": "Mansa Moussa, souverain de l’empire du Mali, part en pèlerinage vers La Mecque."
  },
  {
   "i": 4,
   "t": 13.59,
   "text": "Son royaume est au cœur des échanges commerciaux entre l’Afrique de l’Ouest et le nord du continent."
  },
  {
   "i": 5,
   "t": 18.35,
   "text": "L’or contribue à sa puissance."
  },
  {
   "i": 6,
   "t": 20.28,
   "text": "Avec sa caravane, le souverain remonte le Sahara et atteint Le Caire, capitale du sultanat mamelouk."
  },
  {
   "i": 7,
   "t": 26.26,
   "text": "Là, il est reçu par le sultan d’Égypte."
  },
  {
   "i": 8,
   "t": 28.59,
   "text": "Moussa distribue des cadeaux et son entourage dépense de l’or sur les marchés."
  },
  {
   "i": 9,
   "t": 31.99,
   "text": "Mais cette abondance a une conséquence inattendue."
  },
  {
   "i": 10,
   "t": 34.52,
   "text": "Le métal perd de sa valeur."
  },
  {
   "i": 11,
   "t": 36.41,
   "text": "Des années plus tard, le chroniqueur Al-Omari rapporte que son prix reste déprimé."
  },
  {
   "i": 12,
   "t": 41.39,
   "text": "Il tient son récit de personnes qui ont connu la visite du roi."
  },
  {
   "i": 13,
   "t": 44.28,
   "text": "Impossible cependant de calculer exactement sa fortune en argent d’aujourd’hui."
  },
  {
   "i": 14,
   "t": 48.59,
   "text": "Le pèlerinage continue jusqu’à La Mecque."
  },
  {
   "i": 15,
   "t": 50.76,
   "text": "Puis Moussa rentre au Mali et soutient le développement de Tombouctou comme centre du savoir."
  },
  {
   "i": 16,
   "t": 55.74,
   "text": "En mille trois cent soixante-quinze, l’Atlas catalan représente encore ce roi africain tenant de l’or."
  },
  {
   "i": 17,
   "t": 61.38,
   "text": "Alors, qu’est-ce qui marque le plus durablement l’histoire : la richesse d’un homme, ou ce qu’il en fait ?"
  }
 ]
}